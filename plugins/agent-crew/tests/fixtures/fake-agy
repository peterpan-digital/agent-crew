#!/bin/bash
# A stand-in for the agy CLI, so anti-run's lifecycle can be tested without
# spending a real Antigravity run.
#
# It exists because of a vacuous test: the resume-gate suite asserted "anti
# headless --resume spawned nothing" while anti-run was in fact dying at
# `could not run agy` on every path, gate or no gate. The assertion passed with
# the gate removed. Proving a refusal stopped a spawn requires a spawn that
# would otherwise succeed.
#
# FAKE_MODE picks the shape. FAKE_EVIDENCE is where the "worker" writes.
[ "$1" = "--version" ] && { echo "fake-agy 0.0.1"; exit 0; }
# `agy models`: FAKE_AGY_MODELS (tên cách nhau bằng dấu cách) thay list mặc định,
# FAKE_AGY_MODELS=fail làm lệnh chết. Mặc định là list thật đo 06/11.
if [ "$1" = "models" ]; then
  [ "$FAKE_AGY_MODELS" = "fail" ] && { echo "agy: not signed in" >&2; exit 1; }
  echo "Fetching available models..."
  for m in ${FAKE_AGY_MODELS:-gemini-3.8-flash-high gemini-3.8-flash-medium gemini-3.8-flash-low claude-sonnet-4-6 claude-opus-4-6-thinking gpt-oss-120b-medium}; do
    printf '%s\t%s\n' "$m" "$m"
  done
  exit 0
fi
# `agy -p /quota --output-format json`: in FAKE_AGY_QUOTA; không khai thì chết.
# Phải đứng trước nhánh FAKE_MODE: không thì "worker" giả ghi evidence ngay lúc
# crew mới hỏi quota.
if [ "$1" = "-p" ] && [ "$2" = "/quota" ]; then
  [ -n "$FAKE_AGY_QUOTA" ] || { echo "agy: not signed in" >&2; exit 1; }
  printf '%s\n' "$FAKE_AGY_QUOTA"; exit 0
fi
EV="$FAKE_EVIDENCE"
CONV="${FAKE_CONVERSATION_ID:-conv-fake-0001}"
case "$FAKE_MODE" in
  ok|argvdump)
    # argvdump writes the argv the adapter built, so a flag can be asserted
    # where it lands rather than where it was typed.
    {
      printf 'ARGV=%s\n' "$*"
      printf '\nStatus: DONE\nSummary: ok\n'
    } > "$EV"
    printf '{"status":"SUCCESS","response":"done","conversation_id":"%s","duration_seconds":1,"num_turns":1}\n' "$CONV"
    exit 0 ;;
  no_conv_id)
    # A SUCCESS payload with no conversation_id: what a field rename or a
    # version bump looks like from out here. The adapter must not read the
    # missing field as "resume verified".
    {
      printf 'ARGV=%s\n' "$*"
      printf '\nStatus: DONE\nSummary: ok\n'
    } > "$EV"
    printf '{"status":"SUCCESS","response":"done","duration_seconds":1,"num_turns":1}\n'
    exit 0 ;;
  print_timeout_handoff|print_timeout_nostatus|print_timeout_noid)
    # agy cutting a job at its own --print-timeout: exit 3, but the JSON still
    # carries conversation_id (measured 06/11). The handoff rescue comes back as
    # `--conversation <id>`; FAKE_RESCUE_MARK records each rescue call.
    if [[ " $* " == *" --conversation "* ]]; then
      [ -n "$FAKE_RESCUE_MARK" ] && echo "rescue $*" >> "$FAKE_RESCUE_MARK"
      if [ "$FAKE_MODE" = "print_timeout_handoff" ]; then
        printf '\n## Handoff\n### Đã xong\n- a\n### Đang dở\n- b\n### Bước kế tiếp\n- c\n### File đã đụng\nKhông có\n\nStatus: CONTINUE\n' >> "$EV"
      fi
      printf '{"status":"SUCCESS","response":"đã ghi handoff","conversation_id":"%s","duration_seconds":1,"num_turns":2}\n' "$CONV"
      exit 0
    fi
    printf 'phần đầu\n' > "$EV"
    if [ "$FAKE_MODE" = "print_timeout_noid" ]; then
      printf '{"status":"ERROR","response":"","finished_reason":"print_timeout"}\n'
    else
      printf '{"conversation_id":"%s","status":"ERROR","response":"đang chạy","finished_reason":"print_timeout"}\n' "$CONV"
    fi
    echo "error: print timeout" >&2
    exit 3 ;;
  slow_with_child)
    # A worker that is still busy and has spawned a command of its own: the
    # grandchild writes FAKE_LATE_FILE after FAKE_LATE_SEC unless it is killed.
    # Stopping the adapter must take both down -- an orphan that writes into the
    # run dir later is what overwrote a fresh run on 11/11.
    ( sleep "${FAKE_LATE_SEC:-4}"; echo late > "$FAKE_LATE_FILE" ) &
    echo $$ > "${FAKE_PID_FILE:-/dev/null}"
    sleep 60
    exit 0 ;;
  *) echo "fake-agy: unknown FAKE_MODE '$FAKE_MODE'" >&2; exit 99 ;;
esac
